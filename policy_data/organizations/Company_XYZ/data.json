{
    "plan": "starter_plan",
    "total_storage": "500GB",
    "storage_used": "10MB",
    "email_settings": {
        "default_folders": [
            "Inbox",
            "Sent",
            "Trash"
        ],
        "max_attachment_size": "10MB"
    },
    "roles": {
        "admin": {
            "assigned_policies": {
                "access": "admin_access",
                "password": "standard"
            }
        },
        "user": {
            "assigned_policies": {
                "access": "user_access"
            }
        }
    },
    "defined_policies": {
        "password": {
            "standard": {
                "password_min_length": 12,
                "password_require_number": true
            }
        },
        "access": {
            "admin_access": {
                "api_permissions": {
                    "*": [
                        "create",
                        "read",
                        "update",
                        "delete"
                    ]
                }
            },
            "user_access": {
                "api_permissions": {
                    "/mail/inbox": [
                        "read"
                    ]
                }
            }
        }
    },
    "users": {
        "boss@xyz.com": {
            "org_id": "Company_XYZ",
            "roles": [
                "admin"
            ]
        }
    }
}