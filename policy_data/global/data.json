    "password": {
      "default": {
        "password_min_length": 10,
        "password_require_number": true,
        "password_require_special_char": false,
        "password_require_uppercase": false
      },
      "strict": {
        "password_min_length": 14,
        "password_require_number": true,
        "password_require_special_char": true,
        "password_require_uppercase": true,
        "password_require_lowercase": true
      },
      "weak": {
        "password_min_length": 8,
        "password_require_number": false,
        "password_require_special_char": false
      }
    },
    "mfa": {
      "default": {
        "mfa_required": false,
        "mfa_methods": [
          "totp",
          "email"
        ]
      },
      "strict": {
        "mfa_required": true,
        "mfa_methods": [
          "totp",
          "hardware_key"
        ]
      },
      "admins_only": {
        "mfa_required": true,
        "mfa_methods": [
          "totp"
        ],
        "apply_to_roles": [
          "admin",
          "super_admin"
        ]
      }
    }
  },
  "global_roles": {
    "admin": {
      "assigned_policies": {
        "access": "global_admin_access",
        "password": "strict",
        "mfa": "admins_only"
      }
    },
    "user": {
      "assigned_policies": {
        "access": "global_user_access",
        "password": "default",
        "mfa": "default"
      }
    }
  }
}