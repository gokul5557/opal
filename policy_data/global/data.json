{
    "global_plans": {
        "starter": {
            "storage_per_user": "5GB",
            "max_users": 10,
            "max_domains": 2,
            "max_aliases_per_user": 5,
            "support": "email",
            "features": {
                "smtp": true,
                "imap": true,
                "pop3": true,
                "webmail": true,
                "calendar": true
            }
        },
        "pro": {
            "storage_per_user": "25GB",
            "max_users": 50,
            "max_domains": 10,
            "max_aliases_per_user": 20,
            "support": "priority",
            "features": {
                "smtp": true,
                "imap": true,
                "pop3": true,
                "webmail": true,
                "calendar": true,
                "contacts": true,
                "audit_logs": true
