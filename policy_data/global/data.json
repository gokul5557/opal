            "max_domains": 100,
            "max_aliases_per_user": 100,
            "support": "dedicated",
            "features": {
                "smtp": true,
                "imap": true,
                "pop3": true,
                "webmail": true,
                "calendar": true,
                "contacts": true,
                "audit_logs": true,
                "sso": true,
                "custom_branding": true
            }
        }
    },
    "global_roles": {
        "admin": {
            "assigned_policies": {
                "access": "global_admin_access",
                "password": "strict",
                "mfa": "admins_only"
            }
        },
        "user": {
            "assigned_policies": {
                "access": "global_user_access",
                "password": "default",
                "mfa": "default"
            }
        }
    },
